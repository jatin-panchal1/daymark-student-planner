# ============================================================
# Daymark — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Google OAuth 2.0
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
# Find at: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PostgreSQL Database (Supabase connection string)
# Find at: Project Settings → Database → Connection string → URI
DATABASE_URL=

# Session Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: Server port (defaults to 3000)
PORT=3000
